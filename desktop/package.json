{
  "name": "velodesk",
  "productName": "VeloDesk",
  "version": "0.4.4",
  "description": "VeloDesk: acesso remoto rápido e seguro (código aberto, AGPL-3.0)",
  "author": "Andrey Costa",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "core": "node scripts/build-core.cjs",
    "release": "node scripts/release.cjs",
    "dist:win": "node scripts/build-core.cjs win && electron-builder --win",
    "dist:linux": "node scripts/build-core.cjs linux && electron-builder --linux",
    "dist:mac": "node scripts/build-core.cjs mac macx64 && electron-builder --mac",
    "dist:all": "node scripts/build-core.cjs win linux mac macx64 && electron-builder --win --linux --mac"
  },
  "build": {
    "appId": "com.velodesk.app",
    "productName": "VeloDesk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "extraResources": [
        {
          "from": "resources/win",
          "to": ".",
          "filter": [
            "velodesk.exe",
            "default-server.txt",
            "server-locked.txt"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "icon.png",
      "category": "Network",
      "maintainer": "VeloDesk <velodesk@localhost>",
      "synopsis": "Acesso remoto rÃ¡pido e seguro",
      "description": "VeloDesk: acesso remoto com transferÃªncia de arquivos, chat, gravaÃ§Ã£o de sessÃ£o e controle de permissÃµes.",
      "extraResources": [
        {
          "from": "resources/linux",
          "to": ".",
          "filter": [
            "velodesk",
            "default-server.txt",
            "server-locked.txt"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "icon.png",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/mac-${arch}",
          "to": ".",
          "filter": [
            "velodesk",
            "default-server.txt",
            "server-locked.txt"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "homepage": "https://github.com/andreygiordane/VeloDesk#readme",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreygiordane/VeloDesk.git",
    "directory": "desktop"
  },
  "bugs": {
    "url": "https://github.com/andreygiordane/VeloDesk/issues"
  }
}
